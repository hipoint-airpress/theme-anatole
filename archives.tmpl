<!DOCTYPE html>
    <html lang="zh">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>归档 - {{ blog_title }}</title>
        <meta name="apple-mobile-web-app-capable" content="yes"/>
        <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
        <meta name="format-detection" content="telephone=no"/>
        <meta name="renderer" content="webkit"/>
        <meta name="author" content="{{ user.Nickname }}"/>
        <meta name="keywords" content="{{ meta_keywords }}"/>
        <meta name="description" content="{{ meta_description }}"/>
        <link rel="alternate" type="application/rss+xml" title="atom 1.0" href="{{ atom_url }}"/>
        {% include "common/macro/head" %}
        {% include "caicai_anatole/module/styles" %}
        
    </head>
    <body x-data="{ postSearchVisible: false }">
    {% include "caicai_anatole/module/sidebar" %}
    <div class="main">
        {% include "caicai_anatole/module/page-top" %}
        <div class="content">
            <div class="archive animated fadeInDown">
                <ul class="list-with-title">

                    {% for archive in archives %}
                        <div class="listing-title">{{ archive.Year }}</div>
                        <ul class="listing">

                            {% for post in archive.Posts %}
                                <div class="listing-item">
                                    <div class="listing-post">
                                        <a href="{{ post.FullPath }}" title="{{ post.Title }}">{{ post.Title }}</a>
                                        <div class="post-time">
                                            <span class="date">{{ unix_milli_time_format("2006-01-02", post.CreateTime) }}</span>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </ul>
                        {% endfor %}
                </ul>
            </div>

            {% if posts.Pages > 1 %}
                {% set pagination = archivesPagination(posts.PageNum, posts.Pages, 3) %}
                <div class="pagination flex justify-between items-center">
                    {% if pagination.HasPrev %}
                        <a class="btn" role="navigation" href="{{ pagination.PrevPageFullPath }}">上一页</a>
                    {% endif %}
                    <span class="text-sm">{{ posts.PageNum|add:1 }}/{{ posts.Pages }}</span>
                    {% if pagination.HasNext %}
                        <a class="btn" role="navigation" href="{{ pagination.NextPageFullPath }}">下一页</a>

                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
    {% include "caicai_anatole/module/post-search-modal" %}
    </body>
    </html>
